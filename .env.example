# Copy to .env (gitignored) and fill in.
# Generate keys with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
SECRET_KEY=

# Local Mongo is the default. For the cloud database instead:
# CLOUD_MONGO=1
# MONGO_URI=mongodb+srv://...
# For local Mongo on a non-default host or port:
# MONGO_LOCAL_URI=mongodb://localhost:27017/
